# ==============================================================================
# PLAYZONE BANGLADESH - SECURE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. PostgreSQL Connection Pooling (Transaction Mode via PgBouncer for Serverless Runtime)
# Used by Next.js Server Actions and API Routes
# Format for Supabase: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. Direct PostgreSQL Connection (Direct TCP Port 5432)
# Exclusively used by 'npx prisma migrate deploy' and DDL migrations
# Format for Supabase: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. Cryptographically Secure Secrets
# Generate using: openssl rand -base64 32
ADMIN_SECRET_KEY="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# 4. Payment Gateway Webhook Verification Keys
BKASH_WEBHOOK_SECRET="your-bkash-hmac-sha256-secret"
NAGAD_PUBLIC_KEY="your-nagad-public-key"
SSLCOMMERZ_STORE_PASSWD="your-sslcommerz-store-password"

# 5. Private Storage Bucket for Medical Records (Foundation)
PRIVATE_STORAGE_BUCKET="playzone-foundation-private-docs"
PRIVATE_STORAGE_ENDPOINT="https://your-project-ref.supabase.co/storage/v1"
PRIVATE_STORAGE_ACCESS_KEY="your-storage-access-key"
PRIVATE_STORAGE_SECRET_KEY="your-storage-secret-key"

# 6. Public URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
